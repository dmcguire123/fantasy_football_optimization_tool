<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Emails the morning report (scripts/morning_report.sh) every day at 7:30.
  Install with the command in README.md, under "Morning email".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ffopt.morning-report</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__REPO__/scripts/morning_report.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>7</integer>
        <key>Minute</key><integer>30</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/tmp/ffopt-morning-report.err</string>
</dict>
</plist>
