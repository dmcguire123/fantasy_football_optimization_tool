<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs scripts/weekly_projections.sh three times a week during the season:
  Tuesday morning (after the week ends, before waivers), Thursday afternoon
  (before the Thursday game), and Sunday morning (after the last injury news).
  Install with the command in README.md, under "Projections".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ffopt.projections</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__REPO__/scripts/weekly_projections.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>StandardErrorPath</key>
    <string>/tmp/ffopt-projections.err</string>
</dict>
</plist>
