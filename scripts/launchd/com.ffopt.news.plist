<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scans breaking fantasy news every 3 minutes (scripts/news_watch.sh).
  Install with the command in README.md, under "Breaking news".
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ffopt.news</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__REPO__/scripts/news_watch.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/ffopt-news.err</string>
</dict>
</plist>
