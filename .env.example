# Copy this file to .env and fill in your league details.
# .env is git-ignored, so your cookies stay on your machine.

# ---------------------------------------------------------------------------
# Required: which league and which season
# ---------------------------------------------------------------------------
# Open your league on fantasy.espn.com and look at the address bar:
#   https://fantasy.espn.com/football/league?leagueId=123456&seasonId=2025
# The leagueId is the number below.
ESPN_LEAGUE_ID=

# The season year. A season is named for the year it starts in, so the
# 2025-26 season is 2025. Leave blank to let the app guess the current one.
ESPN_SEASON=

# ---------------------------------------------------------------------------
# Required for private leagues, and for making any roster move
# ---------------------------------------------------------------------------
# Log in to fantasy.espn.com in a browser, then open developer tools:
#   Chrome or Edge: F12, then Application, then Cookies, then espn.com
#   Firefox:        F12, then Storage, then Cookies, then espn.com
#   Safari:         enable the Develop menu, then Develop, Show Web Inspector,
#                   then Storage, then Cookies
# Copy the values of the two cookies named SWID and espn_s2.
#
# SWID looks like {AAAAAAAA-BBBB-CCCC-DDDD-EEEEEEEEEEEE}, braces included.
ESPN_SWID=

# espn_s2 is a long string with percent signs in it. Paste it whole.
ESPN_S2=

# Your own team's id inside the league. Click your team on ESPN and read
# teamId from the address bar. Run `python -m ffopt info` to confirm it.
ESPN_TEAM_ID=

# ---------------------------------------------------------------------------
# Optional behavior
# ---------------------------------------------------------------------------
# Set to true to block every write. Reads and analysis still work. Useful
# while you are getting comfortable that the recommendations look right.
FFOPT_READ_ONLY=false

# Seconds to reuse a fetched league before asking ESPN again.
FFOPT_CACHE_TTL=90

# Seconds before an ESPN request is given up on.
FFOPT_TIMEOUT=20

# ---------------------------------------------------------------------------
# Optional: waiver wire intelligence
# ---------------------------------------------------------------------------
# With a key, Claude reads the expert waiver picks scraped from the web and
# writes the reasoning on the My Targets sheet. Without one the app falls
# back to a plain heuristic. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# Model used for the analysis step.
FFOPT_INTEL_MODEL=claude-sonnet-5

# Seconds to reuse scraped expert picks before fetching them again (6 hours).
FFOPT_INTEL_TTL=21600

# ---------------------------------------------------------------------------
# Optional: nflverse score spreads
# ---------------------------------------------------------------------------
# Measure each player's week-to-week swings from real game logs (downloaded
# once and cached under data/) so the win-probability objective knows who is
# boom-or-bust. Set to false to use fixed per-position spreads instead.
FFOPT_NFLVERSE=true

# ---------------------------------------------------------------------------
# Optional: projections from more than one source
# ---------------------------------------------------------------------------
# "consensus" blends ESPN with Sleeper and (with a key) FantasyPros, each
# scored with this league's rules, and uses the blend everywhere: lineups,
# waivers, win probability. "espn" uses ESPN's projections alone.
FFOPT_PROJECTIONS=consensus

# Free personal key from https://secure.fantasypros.com/api-keys/request/
# Without one, the consensus is ESPN plus Sleeper. The free key allows 100
# calls a day; the app budgets 90 and caches every result for a day.
FANTASYPROS_API_KEY=

# Seconds to reuse fetched projections before pulling them again (3 hours).
FFOPT_PROJECTIONS_TTL=10800

# ---------------------------------------------------------------------------
# Optional: morning email (scripts/morning_report.sh)
# ---------------------------------------------------------------------------
# Where the morning report is emailed. Sent by the Claude CLI through its
# Gmail connector, so the CLI must be signed in to an account that has it.
FFOPT_REPORT_EMAIL=

# Only if you run Claude with a non-default config directory.
CLAUDE_CONFIG_DIR=
